# Required
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
POSTGRES_PASSWORD=

# OpenAI
OPENAI_MODEL=gpt-6-sol
# Optional Admin API key for owner /costs (org billing). Do NOT reuse OPENAI_API_KEY.
# Create at https://platform.openai.com/settings/organization/admin-keys
# OPENAI_ADMIN_API_KEY=
# Optional override for daily news only (empty = OPENAI_MODEL)
# OPENAI_NEWS_MODEL=
# OPENAI_BASE_URL=
# News with web_search can exceed 90s; raise to 120000+ if Responses calls time out
OPENAI_TIMEOUT_MS=90000
OPENAI_MAX_RETRIES=1

# Database (local/dev: set DATABASE_URL; Docker Compose uses PG* below)
# DATABASE_URL=postgres://bot:password@localhost:5432/telegram_bot
POSTGRES_USER=bot
POSTGRES_DB=telegram_bot
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=15000

# Access control — leave empty only for trusted private use (opens all groups)
ALLOWED_CHAT_IDS=
# Your Telegram user id (from @userinfobot). Private /stats, /costs, /personalize and /personalize_results work only for this account.
OWNER_USER_ID=
SUMMARY_ADMIN_ONLY=true

# Summary
DEFAULT_MESSAGE_COUNT=100
MAX_MESSAGE_COUNT=1000
MAX_INPUT_CHARS=60000
MAX_OUTPUT_TOKENS=1500
SUMMARY_COOLDOWN_SECONDS=10
SUMMARY_REQUEST_RETENTION_DAYS=2
SUMMARY_SARCASM_PERCENT=0
TELEGRAM_MAX_MESSAGE_LENGTH=4000
TELEGRAM_MAX_CAPTION_LENGTH=1024

# Funny GIF reaction (/gif) via Giphy — https://developers.giphy.com/
GIF_ENABLED=true
GIPHY_API_KEY=
GIF_DEFAULT_MESSAGE_COUNT=40
GIF_MAX_MESSAGE_COUNT=80
GIF_MAX_INPUT_CHARS=12000
GIF_COOLDOWN_SECONDS=10

# Retention
RETENTION_DAYS=30
RETENTION_CLEANUP_INTERVAL_MS=3600000

# Shared media / process limits
MEDIA_URL_MAX_LENGTH=512
PROCESS_MAX_STDOUT_BYTES=4194304
DOWNLOADER_HTTP_TIMEOUT_SECONDS=15
DOWNLOADER_RETRIES=1
# MEDIA_MAX_CONCURRENT=1
MEDIA_COOLDOWN_SECONDS=10

# Video (yt-dlp)
VIDEO_ENABLED=true
VIDEO_MAX_SIZE_MB=45
VIDEO_MAX_DURATION_SECONDS=180
VIDEO_TIMEOUT_SECONDS=180
VIDEO_COOLDOWN_SECONDS=10
VIDEO_MAX_CONCURRENT=1
VIDEO_MAX_HEIGHT=1080
VIDEO_FFMPEG_THREADS=2
VIDEO_FFMPEG_PRESET=faster
VIDEO_FFMPEG_CRF=23
VIDEO_AUDIO_BITRATE=192k
VIDEO_EXTRACTORS=youtube.*,tiktok.*,vm.tiktok.*,instagram.*,vk.*
VIDEO_CACHE_SIZE=1000

# @mention replies
MENTION_ENABLED=true
MENTION_MAX_INPUT_CHARS=1500
MENTION_MAX_OUTPUT_TOKENS=600
MENTION_COOLDOWN_SECONDS=10
MENTION_IMAGES_ENABLED=true
MENTION_MAX_IMAGES=2
MENTION_VISION_ENABLED=true
MENTION_MAX_INPUT_IMAGES=4
MENTION_MAX_INPUT_IMAGE_MB=5
# Preceding messages before a quoted reply when @mentioned (0 max messages = quote+request only)
MENTION_CONTEXT_MAX_MESSAGES=6
MENTION_CONTEXT_LOOKBACK_MINUTES=10
MENTION_CONTEXT_MAX_CHARS=500
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# Daily interesting news (Europe/Moscow, random time 10:00–21:00)
# Default path: OpenAI Responses API + hosted web_search (extra cost; proxy must support /v1/responses + web_search)
# /usage token totals may understate news cost: web_search has separate pricing beyond input/output tokens
# Claim lease auto-scales: OPENAI_TIMEOUT_MS * (1 + OPENAI_MAX_RETRIES) + 60s, minimum 3 minutes (avoids double-post)
NEWS_ENABLED=true
NEWS_MAX_OUTPUT_TOKENS=700
NEWS_TICK_INTERVAL_MS=60000
NEWS_RETRY_MINUTES=20
NEWS_WEB_SEARCH=true
NEWS_SEARCH_CONTEXT_SIZE=medium
NEWS_FORCE_WEB_SEARCH=true
# NEWS_WEB_SEARCH=false keeps the old Chat Completions path (no live web access)

# Auto-answer unanswered general questions (per-chat opt-in in /settings; this is the global gate)
AUTO_ANSWER_ENABLED=true
AUTO_ANSWER_DELAY_SECONDS=300
AUTO_ANSWER_TICK_INTERVAL_MS=15000
AUTO_ANSWER_MAX_OUTPUT_TOKENS=600
AUTO_ANSWER_MAX_INPUT_CHARS=1500
AUTO_ANSWER_CLAIM_LEASE_MS=180000
# Preceding messages loaded at fire time as OpenAI context (0 max messages = question only)
AUTO_ANSWER_CONTEXT_MAX_MESSAGES=12
AUTO_ANSWER_CONTEXT_LOOKBACK_MINUTES=15
AUTO_ANSWER_CONTEXT_MAX_CHARS=2500

# Chat-participant personalization (per-chat toggle defaults ON; skipped for chats with ≥ PERSONALIZATION_MAX_CHAT_MEMBERS)
PERSONALIZATION_ENABLED=true
PERSONALIZATION_TICK_INTERVAL_MS=60000
PERSONALIZATION_HOUR_MOSCOW=3
PERSONALIZATION_LOOKBACK_HOURS=24
PERSONALIZATION_MAX_CHAT_MEMBERS=20
PERSONALIZATION_MAX_USERS_PER_CHAT=30
PERSONALIZATION_MAX_MESSAGES=500
PERSONALIZATION_MAX_INPUT_CHARS=12000
PERSONALIZATION_MAX_OUTPUT_TOKENS=500
# Draft JSON for multiple users; merge calls still use PERSONALIZATION_MAX_OUTPUT_TOKENS
PERSONALIZATION_DRAFT_MAX_OUTPUT_TOKENS=1500
PERSONALIZATION_PROMPT_MAX_CHARS=3000
PERSONALIZATION_BATCH_USERS=10
# Optional override for personalization only (empty = OPENAI_MODEL)
# OPENAI_PERSONALIZATION_MODEL=

# Chat GC: probe known chats via getChat ~2×/day (Moscow hours); purge DB + drafts if permanently inaccessible
CHAT_GC_ENABLED=true
CHAT_GC_TICK_INTERVAL_MS=3600000
# Comma-separated Europe/Moscow hours (0–23); default 04:00 and 16:00
CHAT_GC_HOURS_MOSCOW=4,16
# Delay between getChat probes (ms); raise if you hit Telegram 429s
CHAT_GC_PROBE_DELAY_MS=75

# Estimated $ for stored usage rows (not OpenAI billing). Defaults match gpt-6-sol + gpt-image-1-mini medium 1024.
OPENAI_INPUT_USD_PER_1M_TOKENS=2
OPENAI_OUTPUT_USD_PER_1M_TOKENS=10
OPENAI_IMAGE_USD=0.011
USAGE_RETENTION_DAYS=90

# Gallery (gallery-dl)
GALLERY_ENABLED=true
GALLERY_MAX_IMAGES=10
GALLERY_MAX_IMAGE_MB=15
GALLERY_MAX_TOTAL_MB=80
GALLERY_TIMEOUT_SECONDS=180
GALLERY_DISK_CHECK_INTERVAL_MS=500
GALLERY_MAX_DIMENSION=1920
GALLERY_OUTPUT_MAX_MB=10
GALLERY_METADATA_MAX_MB=4
GALLERY_WHITELIST=instagram,twitter,reddit,pixiv,imgur
# Hang-prevention timeout for Instagram gallery-dl downloads
INSTAGRAM_DOWNLOAD_TIMEOUT_MS=120000
MARKETPLACE_ENABLED=true
MARKETPLACE_MAX_IMAGES=5
