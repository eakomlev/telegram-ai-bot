{
  "name": "telegram-ai-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --import ./test/setup-env.ts --test test/*.test.ts",
    "test:integration": "node --import tsx --import ./test/setup-env.ts test/db.integration.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "grammy": "^1.38.0",
    "https-proxy-agent": "^9.1.0",
    "node-fetch": "^2.7.0",
    "openai": "^6.0.0",
    "pg": "^8.16.0",
    "playwright": "^1.56.1",
    "socks-proxy-agent": "^10.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
